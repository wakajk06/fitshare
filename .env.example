# FitShare Environment Variables
# Copy this file to .env.local for local development with `vercel dev` or `npm run dev`

# Neon / Vercel PostgreSQL Connection String
# Get this from your Vercel Project -> Storage -> Postgres / Neon Database, or directly from Neon Console (https://neon.tech)
DATABASE_URL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Alternatively, Vercel automatically sets POSTGRES_URL when linking a Vercel Postgres / Neon store
# POSTGRES_URL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
